android_app {
    name: "CloverSetupWizard",

    srcs: ["src/**/*.java"],

    certificate: "platform",
    privileged: true,
    privapp_allowlist: "com.clover.setupwizard.xml",
    system_ext_specific: true,
    platform_apis: true,

    overrides: ["Provision"],

    optimize: {
        proguard_flags_files: ["proguard.flags"],
    },

    static_libs: [
        "androidx.activity_activity",
        "SettingsLib",
        "setupcompat",
        "setupdesign",
        "SystemUISharedLib",
    ],

    libs: ["telephony-common"],
}
